# ── 飞书应用凭证 ──────────────────────────────────────────────────────────────
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书 OAuth 回调地址（测试环境，需在飞书开放平台「安全设置」单独添加）
# 注意：测试环境使用 8081 端口与生产环境 8080 区分
FEISHU_REDIRECT_URI=http://127.0.0.1:8081/auth/feishu/callback

# ── JWT 签名密钥（测试环境独立密钥）────────────────────────────────────────────
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_random_256bit_hex_for_test
JWT_EXPIRE_HOURS=72

# ── 测试数据库（ai00_test，与生产隔离）──────────────────────────────────────────
USERS_DB_URL=postgresql://ai00:password@127.0.0.1:5433/ai00_test

# ── 服务配置 ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8081
DEBUG=true

# ── 超管自举（测试环境用）───────────────────────────────────────────────────────
# 测试库初始化时自动将此邮箱的首个登录用户设为 super_admin
FIRST_SUPER_ADMIN_EMAIL=your-feishu-email@company.com

# ── MinIO 对象存储（可选；留空则回退到本地磁盘 backend/static/uploads/）──────────
# 先运行 scripts\install_minio_service.bat 安装 MinIO Windows 服务，再填写以下配置
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_ACCESS_KEY=ai00_admin
# MINIO_SECRET_KEY=ai00_minio_2025
# MINIO_BUCKET=ai00
# MINIO_PUBLIC_URL=http://pc-pc2l7vve:9000/ai00

