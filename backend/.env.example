# ── 飞书应用凭证（永远不下发到客户端）─────────────────────────────────────
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书 OAuth 回调地址（指向本服务，不是 localhost）
# 需要在飞书开放平台「安全设置」里添加此 URL
FEISHU_REDIRECT_URI=https://your-backend.example.com/auth/feishu/callback

# ── JWT 签名密钥（随机生成，保密）───────────────────────────────────────────
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_random_256bit_hex
JWT_EXPIRE_HOURS=72

# ── 用户数据库（独立 PG 实例）───────────────────────────────────────────────
USERS_DB_URL=postgresql://ai00_user:password@localhost:5432/ai00_users

# ── 服务配置 ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
DEBUG=false

# ── 超管自举（可选）────────────────────────────────────────────────────────────
# 第一个以此飞书邮箱登录的用户自动获得 super_admin 角色。
# DB 中已有超管后此配置自动失效（一次性，不可持续提权）。
# 生产：留空或删除此行，改用 python -m backend.manage create-superadmin
FIRST_SUPER_ADMIN_EMAIL=your-feishu-email@company.com
