# Pi Agent Runtime 灰度开关：legacy 保留旧实现，pi 走独立 runtime
AI00_AGENT_RUNTIME_MODE=legacy
AI00_AGENT_RUNTIME_URL=http://127.0.0.1:8090

# Plugin Platform（生产值必须由 secret manager 注入）
# Ed25519 PKCS#8 private PEM；可把换行编码为字面量 \n。
AI00_PLUGIN_PLATFORM_ED25519_PRIVATE_KEY=
# 至少 32 字节；用于 30-600 秒 Web Plugin 静态资产挂载令牌。
AI00_PLUGIN_MOUNT_SECRET=
AI00_PLATFORM_API_VERSION=1.0.0
AI00_WEB_PLUGIN_SDK_VERSION=0.1.0
# Domain-owned OceanBase/MySQL runtime accounts (same database is allowed;
# credentials and table grants must remain separate).
AI00_AGENT_DB_URL=mysql://agent_runtime:change-me@127.0.0.1:2881/ai00
# Must equal the Agent Runtime secret; inject both values through a secret manager.
AGENT_RUNTIME_SERVICE_TOKEN=
AI00_CRAFT_DB_URL=mysql://craft_runtime:change-me@127.0.0.1:2881/ai00
AI00_SIMULATION_DB_URL=mysql://simulation_runtime:change-me@127.0.0.1:2881/ai00
AI00_DEVICE_DB_URL=mysql://device_runtime:change-me@127.0.0.1:2881/ai00

# Deployment migration account only; never give DDL credentials to app runtimes.
AI00_DDL_DB_URL=mysql://ai00_ddl:change-me@127.0.0.1:2881/ai00
AI00_REQUIRE_MIGRATIONS=1
# Knowledge legacy migration acceptance (non-production only)
AI00_DEPLOYMENT_ENV=staging
AI00_KNOWLEDGE_ACCEPTANCE_TENANT_GID=
AI00_KNOWLEDGE_ACCEPTANCE_SPACE_GID=
AI00_KNOWLEDGE_ACCEPTANCE_ACTOR_GID=
# Set only during an approved staging write acceptance:
AI00_KNOWLEDGE_ACCEPTANCE_WRITE_TOKEN=
