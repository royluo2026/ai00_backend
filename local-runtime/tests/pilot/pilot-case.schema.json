{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai00.example/schemas/connector-vismockup-pilot-case-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ai00_base", "environment_id", "environment_version", "device_id", "expected_operation_ids"],
  "properties": {
    "ai00_base": { "type": "string", "format": "uri", "pattern": "^https://" },
    "environment_id": { "type": "string", "minLength": 1 },
    "environment_version": { "type": "integer", "minimum": 1 },
    "device_id": { "type": "string", "minLength": 1 },
    "expected_document_id": { "type": "string", "minLength": 1 },
    "expected_snapshot_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "expected_operation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
