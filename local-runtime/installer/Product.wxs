<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="AI00 Connector" Manufacturer="AI00" Version="1.0.0" UpgradeCode="0E32A2D0-CDEA-43E9-9EAA-1A418F590EB4" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer AI00 Connector is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AI00 Connector">
        <Component Id="Ai00ConnectorServiceComponent" Guid="*">
          <File Id="Ai00ConnectorServiceExe" Source="$(var.ServicePublishDir)\Ai00.Connector.Service.exe" KeyPath="yes" />
          <ServiceInstall Id="Ai00ConnectorService" Name="AI00Connector" DisplayName="AI00 Connector" Start="auto" Type="ownProcess" ErrorControl="normal" Account="NT AUTHORITY\LocalService" />
          <ServiceControl Id="StartAi00Connector" Name="AI00Connector" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <Component Id="Ai00ConnectorSessionHost" Guid="*">
          <File Id="Ai00ConnectorSessionHostExe" Source="$(var.SessionHostPublishDir)\Ai00.Connector.SessionHost.exe" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="AI00 Connector SessionHost" Value="&quot;[INSTALLFOLDER]Ai00.Connector.SessionHost.exe&quot;" Type="string" />
        </Component>
        <Component Id="Ai00ConnectorTray" Guid="*">
          <File Id="Ai00ConnectorTrayExe" Source="$(var.TrayPublishDir)\Ai00.Connector.Tray.exe" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="AI00 Connector Tray" Value="&quot;[INSTALLFOLDER]Ai00.Connector.Tray.exe&quot;" Type="string" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="Ai00ProgramData" Name="AI00">
        <Directory Id="Ai00ConnectorProgramData" Name="Connector">
          <Component Id="Ai00ConnectorProgramDataAcl" Guid="*">
            <CreateFolder />
            <RegistryValue Root="HKLM" Key="Software\AI00\Connector" Name="BoundUserStartupTask" Value="AI00 Connector SessionHost" Type="string" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <Feature Id="Complete" Title="AI00 Connector" Level="1">
      <ComponentRef Id="Ai00ConnectorServiceComponent" />
      <ComponentRef Id="Ai00ConnectorSessionHost" />
      <ComponentRef Id="Ai00ConnectorTray" />
      <ComponentRef Id="Ai00ConnectorProgramDataAcl" />
      <ComponentGroupRef Id="Ai00ConnectorServicePayload" />
      <ComponentGroupRef Id="Ai00ConnectorSessionHostPayload" />
      <ComponentGroupRef Id="Ai00ConnectorTrayPayload" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="Ai00ConnectorServicePayload" Directory="INSTALLFOLDER">
      <Files Include="$(var.ServicePublishDir)\**">
        <Exclude Files="$(var.ServicePublishDir)\Ai00.Connector.Service.exe" />
      </Files>
    </ComponentGroup>
    <ComponentGroup Id="Ai00ConnectorSessionHostPayload" Directory="INSTALLFOLDER">
      <Files Include="$(var.SessionHostPublishDir)\**">
        <Exclude Files="$(var.SessionHostPublishDir)\Ai00.Connector.SessionHost.exe" />
        <Exclude Files="$(var.SessionHostPublishDir)\Ai00.Connector.Contracts.dll" />
        <Exclude Files="$(var.SessionHostPublishDir)\Ai00.Connector.Contracts.pdb" />
      </Files>
    </ComponentGroup>
    <ComponentGroup Id="Ai00ConnectorTrayPayload" Directory="INSTALLFOLDER">
      <Files Include="$(var.TrayPublishDir)\**">
        <Exclude Files="$(var.TrayPublishDir)\Ai00.Connector.Tray.exe" />
        <Exclude Files="$(var.TrayPublishDir)\Ai00.Connector.Contracts.dll" />
        <Exclude Files="$(var.TrayPublishDir)\Ai00.Connector.Contracts.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
