{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai00.example/contracts/plugin-manifest-v2.schema.json",
  "title": "AI00 Plugin Manifest v2 descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin_id", "publisher_id", "name", "version", "compatibility", "runtimes", "permissions", "data"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "plugin_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*){2,7}$" },
    "publisher_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "compatibility": {
      "type": "object", "additionalProperties": false, "required": ["platform_api", "web_sdk"],
      "properties": { "platform_api": { "type": "string" }, "web_sdk": { "type": "string" } }
    },
    "runtimes": {
      "type": "object", "additionalProperties": false, "required": ["web"],
      "properties": { "web": { "type": "object", "additionalProperties": false, "required": ["entry", "sandbox"], "properties": { "entry": { "type": "string" }, "sandbox": { "const": "allow-scripts" } } } }
    },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["object_key", "sha256", "size", "media_type"], "properties": { "object_key": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "size": { "type": "integer", "minimum": 1, "maximum": 104857600 }, "media_type": { "const": "application/zip" } } },
    "data": {
      "type": "object", "additionalProperties": false, "required": ["stores_personal_data", "retention", "uninstall"],
      "properties": {
        "stores_personal_data": { "type": "boolean" },
        "retention": { "enum": ["none", "while-installed", "tenant-policy"] },
        "uninstall": { "enum": ["delete", "retain", "export-then-delete"] }
      }
    }
  }
}
