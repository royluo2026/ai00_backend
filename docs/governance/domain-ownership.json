      "provider_paths": [
        "plugins/knowledge/knowledge_backend/capabilities/**",
        "backend/capabilities/knowledge_*",
        "backend/capabilities/proposals_next.py",
        "backend/capabilities/proposal_query_next.py",
        "backend/capabilities/review_next.py",
        "backend/capabilities/outbox_next.py",
        "backend/capabilities/outbox_retry_next.py"
      ],
      "migration_paths": [
