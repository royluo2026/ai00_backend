      "artifact": "ai00-base-platform",
      "module_prefixes": ["backend.system_capabilities", "backend.plugin_platform"],
      "code_paths": [
        "backend/base/**",
        "backend/system_capabilities/**",
        "backend/plugin_platform/**",
        "backend/config.py",
        "backend/core/**",
        "backend/db/connection.py",
        "backend/utils/gid.py",
        "backend/capabilities/registry_next.py",
        "backend/capabilities/system_shared_next.py",
        "backend/capabilities/plugin_marketplace_next.py",
        "backend/domain_ports/versioned_resources.py",
        "backend/domain_ports/resource_authorization.py",
        "services/mcp-gateway/**"
      ],
      "provider_paths": ["backend/system_capabilities/base_provider.py"],
      "migration_paths": [
        "backend/db/migrations/202608030006_base_platform_runtime_tables.sql",
        "backend/db/migrations/202608030010_base_self_annotations.sql",
        "backend/db/migrations/202608040001_base_plugin_namespace_storage.sql",
