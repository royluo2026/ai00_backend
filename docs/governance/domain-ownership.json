        "backend/db/migrations/202608100004_base_artifacts_and_operations.sql",
        "backend/db/migrations/202608100005_base_plugin_mount_sessions.sql",
        "backend/db/migrations/202608100007_base_revision_lineage.sql"
      ],
      "test_paths": ["backend/tests/test_base_*.py"],
      "documentation_paths": ["docs/capabilities/base-platform/**"]
    },
    "Agent": {
      "maintainers": ["@ai00/agent-maintainers"],
      "artifact": "ai00-agent-runtime",
      "module_prefixes": ["plugins.agent"],
