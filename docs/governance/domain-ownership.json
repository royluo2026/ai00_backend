{
  "schema_version": 1,
  "resolution": "The most specific matching code path wins; equal-specificity claims are invalid.",
  "shared_import_prefixes": [
    "backend.capability_v2",
    "backend.domain_ports",
    "backend.contracts",
    "backend.platform_sdk"
  ],
