{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Coverage Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "reviewed_against",
    "unreviewed_functions",
    "excluded_functions",
    "capabilities",
    "code_extractions",
    "database_boundaries",
    "debt_dispositions",
    "review"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "domain": {"type": "string", "minLength": 1},
    "reviewed_against": {"$ref": "#/$defs/ReviewedAgainst"},
    "unreviewed_functions": {"$ref": "#/$defs/UnreviewedFunctions"},
    "excluded_functions": {"$ref": "#/$defs/ExcludedFunctions"},
    "capabilities": {"$ref": "#/$defs/Capabilities"},
    "official_provider_capabilities": {"$ref": "#/$defs/OfficialProviderCapabilities"},
    "code_extractions": {"type": "array", "items": {"$ref": "#/$defs/CodeExtraction"}},
    "database_boundaries": {"type": "array", "items": {"$ref": "#/$defs/DatabaseBoundary"}},
    "debt_dispositions": {"type": "array", "items": {"$ref": "#/$defs/DebtDisposition"}},
    "review": {"$ref": "#/$defs/Review"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {"properties": {"status": {"const": "approved"}}, "required": ["status"]}
        },
        "required": ["review"]
      },
      "then": {"properties": {"unreviewed_functions": {"maxProperties": 0}}}
    }
  ],
  "$defs": {
    "OfficialProviderCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "artifact_sha256", "capability_ids"],
      "properties": {
        "module": {"const": "backend.base.official_provider"},
        "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "capability_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ReviewedAgainst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "registry_sha256", "catalog_release", "catalog_sha256"],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "registry_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "catalog_release": {"type": "string", "minLength": 1},
        "catalog_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "Resolution": {
      "enum": ["unreviewed", "existing_capability", "new_capability", "excluded"]
    },
    "UnreviewedFunctions": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {"type": "string", "minLength": 1},
      "patternProperties": {"^.+$": {"$ref": "#/$defs/UnreviewedFunction"}}
    },
    "UnreviewedFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "source_paths", "owner", "evidence"],
      "properties": {
        "resolution": {"const": "unreviewed"},
        "source_paths": {"$ref": "#/$defs/SourcePaths"},
        "owner": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 20}
      }
    },
    "ExcludedFunctions": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {"type": "string", "minLength": 1},
      "patternProperties": {"^.+$": {"$ref": "#/$defs/ExcludedFunction"}}
    },
    "ExcludedFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "target_capability", "source_paths", "evidence", "reason", "classification", "owner", "reviewer", "reviewed_at"],
      "properties": {
        "resolution": {"const": "excluded"},
        "target_capability": {"const": null},
        "source_paths": {"$ref": "#/$defs/SourcePaths"},
        "evidence": {"type": "string", "minLength": 20},
        "reason": {
          "type": "string",
          "minLength": 20,
          "not": {"const": "This is not a capability and needs no review."}
        },
        "classification": {"enum": ["internal", "operations", "ui_transient", "transport_adapter", "unstable_product_surface"]},
        "owner": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"$ref": "#/$defs/ReviewDate"}
      }
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {"type": "string", "minLength": 1},
      "patternProperties": {"^.+$": {"$ref": "#/$defs/CapabilityGroup"}}
    },
    "CapabilityGroup": {
      "oneOf": [
        {"$ref": "#/$defs/ExistingCapabilityGroup"},
        {"$ref": "#/$defs/CandidateCapabilityGroup"}
      ]
    },
    "ExistingCapabilityGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "function_dispositions", "consumer_exposure"],
      "properties": {
        "kind": {"const": "existing"},
        "function_dispositions": {"$ref": "#/$defs/ExistingFunctionDispositions"},
        "consumer_exposure": {"$ref": "#/$defs/ConsumerExposure"}
      }
    },
    "CandidateCapabilityGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "function_dispositions", "consumer_exposure", "candidate_definition"],
      "properties": {
        "kind": {"const": "candidate"},
        "function_dispositions": {"$ref": "#/$defs/CandidateFunctionDispositions"},
        "consumer_exposure": {"$ref": "#/$defs/ConsumerExposure"},
        "candidate_definition": {"$ref": "#/$defs/CandidateDefinition"}
      }
    },
    "ExistingFunctionDispositions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "patternProperties": {"^.+$": {"$ref": "#/$defs/ExistingFunctionDisposition"}}
    },
    "CandidateFunctionDispositions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "patternProperties": {"^.+$": {"$ref": "#/$defs/CandidateFunctionDisposition"}}
    },
    "ExistingFunctionDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "source_paths", "owner", "evidence", "reviewer", "reviewed_at"],
      "properties": {
        "resolution": {"const": "existing_capability"},
        "source_paths": {"$ref": "#/$defs/SourcePaths"},
        "owner": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 20},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"$ref": "#/$defs/ReviewDate"}
      }
    },
    "CandidateFunctionDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "source_paths", "owner", "evidence", "reviewer", "reviewed_at"],
      "properties": {
        "resolution": {"const": "new_capability"},
        "source_paths": {"$ref": "#/$defs/SourcePaths"},
        "owner": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 20},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"$ref": "#/$defs/ReviewDate"}
      }
    },
    "SourcePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ReviewDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "CandidateDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_outcome", "non_goals", "owner_domain", "application_port", "provider_artifact", "owned_tables", "migration_stream"],
      "properties": {
        "business_outcome": {"type": "string", "minLength": 1},
        "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "owner_domain": {"type": "string", "minLength": 1},
        "application_port": {"type": "string", "minLength": 1},
        "provider_artifact": {"type": "string", "minLength": 1},
        "owned_tables": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "migration_stream": {"type": "string", "minLength": 1}
      }
    },
    "ConsumerExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared_pipeline", "web", "rest", "plugin", "agent", "mcp", "local_runtime"],
      "properties": {
        "shared_pipeline": {"const": "capability_provider_gateway"},
        "web": {"$ref": "#/$defs/Exposure"},
        "rest": {"$ref": "#/$defs/Exposure"},
        "plugin": {"$ref": "#/$defs/Exposure"},
        "agent": {"$ref": "#/$defs/Exposure"},
        "mcp": {"$ref": "#/$defs/Exposure"},
        "local_runtime": {"$ref": "#/$defs/Exposure"}
      }
    },
    "Exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "reason", "policy_ref"],
      "properties": {
        "enabled": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "policy_ref": {"type": "string", "minLength": 1}
      }
    },
    "CodeExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_paths", "owner_domain", "target_application_port", "shared_pipeline", "disposition"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_paths": {"$ref": "#/$defs/SourcePaths"},
        "owner_domain": {"type": "string", "minLength": 1},
        "target_application_port": {"type": "string", "minLength": 1},
        "shared_pipeline": {"const": "capability_provider_gateway"},
        "disposition": {"enum": ["planned", "completed", "not_required"]}
      }
    },
    "DatabaseBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "owner_domain", "access_mode", "migration_stream", "evidence"],
      "properties": {
        "table": {"type": "string", "minLength": 1},
        "owner_domain": {"type": "string", "minLength": 1},
        "access_mode": {"enum": ["read", "write", "read_write"]},
        "migration_stream": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "DebtDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "source_paths", "owner_domain", "current_owner", "target_owner", "replacement_boundary", "resolution_plan", "disposition", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["consumer_adapter", "dependency", "database", "migration", "legacy_implementation"]},
        "source_paths": {"$ref": "#/$defs/SourcePaths"},
        "owner_domain": {"type": "string", "minLength": 1},
        "current_owner": {"type": "string", "minLength": 1},
        "target_owner": {"type": "string", "minLength": 1},
        "replacement_boundary": {"type": "string", "minLength": 1},
        "resolution_plan": {"type": "string", "minLength": 20},
        "disposition": {"enum": ["remove_after_extraction", "retain_with_boundary", "migrate", "accepted"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewed_at", "status"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"$ref": "#/$defs/ReviewDate"},
        "status": {"enum": ["draft", "approved"]}
      }
    }
  }
}
