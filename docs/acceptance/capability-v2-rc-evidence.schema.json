{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability V2 RC Runtime Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "generated_at", "catalog_release", "catalog_hash", "git_commit", "migration", "domain_manifest", "domain_migrations", "provider_artifacts", "environment_id", "component_results", "probe_provenance", "database_isolation", "capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "catalog_release": {"type": "string", "pattern": "^rel_[0-9a-f]{32}$"},
    "catalog_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migration_id", "filename", "sha256"],
      "properties": {
        "migration_id": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "pattern": "^[^/\\\\]+\\.sql$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "domain_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {"const": "backend/capability_v2/official_domains.json"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "domain_migrations": {
      "type": "array",
      "minItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain_id", "migration_id", "filename", "sha256", "artifact_version"],
        "properties": {
          "domain_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "migration_id": {"type": "string", "pattern": "^[0-9]{4}$"},
          "filename": {"type": "string", "pattern": "^[0-9]{4}_[a-z][a-z0-9_]*\\.sql$"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "artifact_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "provider_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plugin_id", "artifact_hash"],
        "properties": {
          "plugin_id": {"type": "string", "minLength": 1},
          "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "environment_id": {"type": "string", "minLength": 1},
    "component_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_gateway", "plugin", "agent", "mcp", "local_runtime"],
      "properties": {
        "backend_gateway": {"const": "passed"},
        "plugin": {"const": "passed"},
        "agent": {"const": "passed"},
        "mcp": {"const": "passed"},
        "local_runtime": {"const": "passed"}
      }
    },
    "probe_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_sha256", "components"],
      "properties": {
        "outcome_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend_gateway", "plugin", "agent", "mcp", "local_runtime"],
          "properties": {
            "backend_gateway": {"$ref": "#/$defs/componentProbe"},
            "plugin": {"$ref": "#/$defs/componentProbe"},
            "agent": {"$ref": "#/$defs/componentProbe"},
            "mcp": {"$ref": "#/$defs/componentProbe"},
            "local_runtime": {"$ref": "#/$defs/componentProbe"}
          }
        }
      }
    },
    "database_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_operations", "cross_domain"],
      "properties": {
        "owner_operations": {
          "type": "object",
          "minProperties": 11,
          "maxProperties": 11,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider_crud", "migration_ledger", "database_read", "database_write", "runtime_ddl"],
            "properties": {
              "provider_crud": {"const": "passed"},
              "migration_ledger": {"const": "passed"},
              "database_read": {"const": "passed"},
              "database_write": {"const": "passed"},
              "runtime_ddl": {"const": "denied"}
            }
          }
        },
        "cross_domain": {
          "type": "array",
          "minItems": 110,
          "maxItems": 110,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_domain", "target_domain", "read", "write"],
            "properties": {
              "source_domain": {"type": "string", "minLength": 1},
              "target_domain": {"type": "string", "minLength": 1},
              "read": {"const": "denied"},
              "write": {"const": "denied"}
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "invalid_input", "unauthenticated", "resource_denied", "output_contract", "consumer_contract", "version_pin"],
        "properties": {
          "success": {"const": "passed"}, "invalid_input": {"const": "passed"},
          "unauthenticated": {"const": "passed"}, "resource_denied": {"const": "passed"},
          "output_contract": {"const": "passed"}, "consumer_contract": {"const": "passed"},
          "version_pin": {"const": "passed"}
        }
      }
    }
  },
  "$defs": {
    "componentProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "checks", "duration_ms", "correlation_ids"],
      "properties": {
        "endpoint": {"type": "string", "minLength": 1},
        "checks": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "duration_ms": {"type": "integer", "minimum": 0},
        "correlation_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
