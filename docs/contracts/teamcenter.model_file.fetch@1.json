{
  "id": "teamcenter.model_file.fetch@1",
  "input": {
    "type": "object",
    "properties": {
      "batch_id": {
        "type": "string",
        "pattern": "^[a-f0-9]{32}$"
      },
      "generation": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[a-f0-9]{32}$"
      },
      "snapshot_hash": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "schema_version": {
        "const": 1,
        "type": "integer"
      },
      "node_key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "item_revision_uid": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "source_selector": {
        "type": "object",
        "properties": {
          "endpoint_id": {
            "type": "string",
            "const": "tc-production"
          },
          "object_uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "item_revision_uid": {
            "type": "string",
            "maxLength": 128
          },
          "bom_view_uid": {
            "type": "string",
            "maxLength": 128
          },
          "revision_rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "configuration_date": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "required": [
          "endpoint_id",
          "object_uid",
          "item_revision_uid",
          "bom_view_uid",
          "revision_rule",
          "configuration_date"
        ]
      },
      "file_ref": {
        "type": "object",
        "properties": {
          "dataset_uid": {
            "type": "string",
            "minLength": 1
          },
          "file_uid": {
            "type": "string",
            "minLength": 1
          },
          "file_name": {
            "type": "string"
          },
          "relation_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "dataset_uid",
          "file_uid",
          "file_name",
          "relation_type"
        ]
      },
      "expected_content_hash": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "artifact_resource_refs": {
        "type": "array",
        "maxItems": 2,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "batch_id",
      "generation",
      "snapshot_hash",
      "schema_version",
      "node_key",
      "item_revision_uid",
      "source_selector",
      "file_ref",
      "expected_content_hash",
      "artifact_resource_refs"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "identity": {
        "type": "object",
        "properties": {
          "batch_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "generation": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{32}$"
          },
          "snapshot_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "schema_version": {
            "const": 1,
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "required": [
          "batch_id",
          "generation",
          "snapshot_hash",
          "schema_version"
        ]
      },
      "node_key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "item_revision_uid": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "file_ref": {
        "type": "object",
        "properties": {
          "dataset_uid": {
            "type": "string",
            "minLength": 1
          },
          "file_uid": {
            "type": "string",
            "minLength": 1
          },
          "file_name": {
            "type": "string"
          },
          "relation_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "dataset_uid",
          "file_uid",
          "file_name",
          "relation_type"
        ]
      },
      "artifact_ref": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "enum": [
              "model/jt",
              "model/plmxml",
              "application/vnd.siemens.plmxml+xml",
              "model/step",
              "image/png"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "media_type",
          "sha256",
          "byte_size",
          "version"
        ]
      },
      "content_hash": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "byte_length": {
        "type": "integer",
        "minimum": 24,
        "maximum": 536870912
      },
      "acquired_at": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "captured_bytes_verified": {
        "const": false,
        "type": "boolean"
      }
    },
    "additionalProperties": false,
    "required": [
      "identity",
      "node_key",
      "item_revision_uid",
      "file_ref",
      "artifact_ref",
      "content_hash",
      "byte_length",
      "acquired_at",
      "captured_bytes_verified"
    ]
  }
}
