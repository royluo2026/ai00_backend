{
  "id": "teamcenter.model_cache.read@2",
  "input": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "source_selector": {
        "type": "object",
        "properties": {
          "endpoint_id": {
            "type": "string",
            "const": "tc-production"
          },
          "object_uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "item_revision_uid": {
            "type": "string",
            "maxLength": 128
          },
          "bom_view_uid": {
            "type": "string",
            "maxLength": 128
          },
          "revision_rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "configuration_date": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "required": [
          "endpoint_id",
          "object_uid",
          "item_revision_uid",
          "bom_view_uid",
          "revision_rule",
          "configuration_date"
        ]
      },
      "batch_id": {
        "type": "string",
        "pattern": "^[a-f0-9]{32}$"
      },
      "cursor": {
        "type": "integer",
        "minimum": 0,
        "maximum": 250000
      },
      "page_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500
      },
      "generation": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[a-f0-9]{32}$"
      },
      "expected_principal_hash": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "required": [
      "source_selector",
      "batch_id",
      "cursor",
      "page_size",
      "generation",
      "expected_principal_hash"
    ]
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "principal_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "result_json": {
        "type": "string",
        "minLength": 2,
        "maxLength": 8388608
      }
    },
    "required": [
      "principal_hash",
      "result_json"
    ]
  }
}
